# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must NEVER be committed.
#   PowerShell:  Copy-Item .env.example .env.local
#   bash/macOS:  cp .env.example .env.local

# --- LiveKit (video) --- get from https://cloud.livekit.io
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Google Gemini (AI suggestions + embeddings) --- get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- Representative login (you choose these) ---
REP_USERNAME=rep
REP_PASSWORD=choose_a_strong_password

# --- Session JWT signing secret --- must be at least 32 characters: `openssl rand -hex 32`
AUTH_SECRET=generate_a_long_random_string

# --- Shared session store (REQUIRED when deployed to Vercel / any serverless host) ---
# Without these the app keeps sessions in process memory, which is fine for `npm run dev` but
# breaks on serverless: each API route can run on a different instance, so a customer's join
# link would intermittently fail. Create a free database at https://console.upstash.com
# (or add the Upstash integration from the Vercel dashboard, which sets these for you).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --- Optional ---
# Name the customer sees on their join link. Only used if the representative leaves the consent
# signature blank; otherwise the typed signature is used.
# REP_DISPLAY_NAME=Your Name

# Set to 1 when serving `npm run dev` through a public HTTPS tunnel (ngrok, cloudflared) so the
# session cookie is still marked Secure outside a production build.
# PUBLIC_TUNNEL=1
