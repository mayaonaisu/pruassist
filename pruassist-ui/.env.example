# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and must NEVER be committed.
#   PowerShell:  Copy-Item .env.example .env.local
#   bash/macOS:  cp .env.example .env.local

# --- LiveKit (video) --- get from https://cloud.livekit.io
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Google Gemini (AI suggestions + embeddings) --- get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- Representative login (you choose these) ---
REP_USERNAME=rep
REP_PASSWORD=choose_a_strong_password

# --- Session JWT signing secret --- any long random string, e.g. from `openssl rand -hex 32`
AUTH_SECRET=generate_a_long_random_string
