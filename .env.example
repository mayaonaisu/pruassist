# Every value below is required. On Vercel these live in Settings → Environment Variables;
# a local .env.local is gitignored and must NEVER be committed.

# --- LiveKit (video) --- https://cloud.livekit.io → Settings → Keys
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Google Gemini (talking points + embeddings) --- https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# --- Shared session store --- https://console.upstash.com → your database → REST API
# Not optional on Vercel: each API route can run on a different serverless instance, so
# sessions held in process memory would make customer join links fail intermittently.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --- Representative login (you choose these) ---
REP_USERNAME=rep
REP_PASSWORD=choose_a_strong_password

# --- Session JWT signing secret --- at least 32 characters, or startup fails:
#   openssl rand -hex 32
AUTH_SECRET=generate_a_long_random_string

# --- Optional ---
# Name the customer sees on their join link. Used only if the representative leaves the
# consent signature blank; otherwise the typed signature is used.
# REP_DISPLAY_NAME=Your Name
