# Every value below is required. On Vercel these live in Settings → Environment Variables;
# a local .env.local is gitignored and must NEVER be committed.

# --- LiveKit (video) --- https://cloud.livekit.io → Settings → Keys
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Google Gemini (talking points + embeddings) --- https://aistudio.google.com/apikey
GEMINI_API_KEY

# Optional extra keys, from other projects, rotated in when the one above hits its quota. The free
# tier allows 20 generateContent calls per model per day and 10 per minute, which one advisory
# session can exhaust; a second key doubles the headroom and costs nothing. Up to _16 are read.
# Every key must be able to reach PRUASSIST_MODEL — a key issued to a newly created project cannot
# use gemini-2.5-flash, which is why the default is a model they all serve.
# GEMINI_API_KEY_2=your_gemini_api_key
# GEMINI_API_KEY_3=your_gemini_api_key   # …through GEMINI_API_KEY_16

# --- Shared session store --- https://console.upstash.com → your database → REST API
# Not optional on Vercel: each API route can run on a different serverless instance, so
# sessions held in process memory would make customer join links fail intermittently.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# --- Representative login (you choose these) ---
REP_USERNAME=rep
REP_PASSWORD=choose_a_strong_password

# --- Session JWT signing secret --- at least 32 characters, or startup fails:
#   openssl rand -hex 32
AUTH_SECRET=generate_a_long_random_string

# --- Optional ---
# Set to 0 to turn off comprehension tracking (the concept ledger and its alerts) without a
# deploy. The live pointers, the call and the brief all keep working.
# PRUASSIST_DEEP=0

# Set to 0 to turn off just the lookahead — the background pass that pre-writes and verifies the
# answer to the question the customer is most likely to ask next. It is the expensive stage;
# comprehension tracking works fully without it.
# PRUASSIST_LOOKAHEAD=0

# Which Gemini model the co-pilot uses. Defaults to gemini-2.5-flash. Free-tier quota is per
# project PER MODEL PER DAY — 20 generateContent requests/day on gemini-2.5-flash at the time of
# writing, which one lookahead can consume a third of. Pointing this at another model is the
# fastest way out of a quota wall mid-demo; the thinking config adapts to the model family.
# PRUASSIST_MODEL=gemini-2.5-flash

# Name the customer sees on their join link. Used only if the representative leaves the
# consent signature blank; otherwise the typed signature is used.
# REP_DISPLAY_NAME=Your Name

# --- Orchestrator brain (routes each turn to a mode; falls back to a deterministic router when
# absent, so the app still works with these unset). OpenAI-compatible endpoint. ---
ORCHESTRATOR_BASE_URL=https://openrouter.ai/api/v1
ORCHESTRATOR_MODEL=nvidia/nemotron-3.5-lightning:free
# ORCHESTRATOR_API_KEY=your_openrouter_key

# --- Optional: Deepgram STT (brand-term-accurate transcription) --- https://console.deepgram.com
# Replaces the browser's Web Speech recognizer with Deepgram streaming + keyterm boosting, so
# PRUShield / PRUExtra / PRUPanel Connect are recognised at decode time. The browser gets a
# short-lived token minted server-side, so the KEY BELOW MUST HAVE OWNER SCOPE (a usage-only key
# cannot grant tokens — the app then falls back to Web Speech automatically). Unset = Web Speech.
# DEEPGRAM_API_KEY=your_owner_scoped_deepgram_key
# Client flag: set to 1 to use Deepgram when configured; anything else keeps Web Speech.
# NEXT_PUBLIC_ENABLE_DEEPGRAM=1
